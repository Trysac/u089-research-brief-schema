{"$schema":"https://json-schema.org/draft/2020-12/schema","title":"Monitored topics","description":"Monitored topics contract, version 1.x. Cross-field rules cannot be expressed in JSON Schema and are enforced only by research_brief_schema.validate_topics: topic ids must be unique and keywords and exclude_keywords must be disjoint after case folding.","type":"object","additionalProperties":false,"required":["schema_version","topics"],"properties":{"schema_version":{"type":"string","pattern":"^1[.](0|[1-9][0-9]{0,8})$"},"topics":{"type":"array","maxItems":500,"minItems":1,"items":{"$ref":"#/$defs/topic"}}},"$defs":{"id":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{0,63}$"},"topic":{"type":"object","additionalProperties":false,"required":["id","name","keywords","cadence","priority","active"],"properties":{"id":{"$ref":"#/$defs/id"},"name":{"type":"string","minLength":1,"maxLength":200},"keywords":{"type":"array","minItems":1,"maxItems":100,"items":{"type":"string","minLength":1,"maxLength":100}},"exclude_keywords":{"type":"array","maxItems":100,"items":{"type":"string","minLength":1,"maxLength":100}},"cadence":{"type":"string","enum":["daily","weekly","monthly"]},"priority":{"type":"integer","minimum":1,"maximum":5},"active":{"type":"boolean"}}}}}