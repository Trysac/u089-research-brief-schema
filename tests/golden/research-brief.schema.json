{"$schema":"https://json-schema.org/draft/2020-12/schema","title":"Research brief","description":"Research brief contract, version 1.x. Cross-field rules cannot be expressed in JSON Schema and are enforced only by research_brief_schema.validate_brief: source ids must be unique and every finding evidence entry must reference an existing source id.","type":"object","additionalProperties":false,"required":["schema_version","id","topic_id","created_at","title","summary","findings","sources"],"properties":{"schema_version":{"type":"string","pattern":"^1[.](0|[1-9][0-9]{0,8})$"},"id":{"$ref":"#/$defs/id"},"topic_id":{"$ref":"#/$defs/id"},"created_at":{"$ref":"#/$defs/datetime"},"title":{"type":"string","minLength":1,"maxLength":200},"summary":{"type":"string","minLength":1,"maxLength":2000},"findings":{"type":"array","maxItems":1000,"items":{"$ref":"#/$defs/finding"}},"sources":{"type":"array","maxItems":1000,"items":{"$ref":"#/$defs/source"}},"open_questions":{"type":"array","maxItems":100,"items":{"type":"string","minLength":1,"maxLength":1000}},"tags":{"type":"array","maxItems":100,"items":{"type":"string","minLength":1,"maxLength":64,"pattern":"^[a-z0-9]+(-[a-z0-9]+)*$"}},"extras":{"type":"object"}},"$defs":{"id":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{0,63}$"},"datetime":{"type":"string","format":"date-time"},"finding":{"type":"object","additionalProperties":false,"required":["claim","evidence","confidence"],"properties":{"claim":{"type":"string","minLength":1,"maxLength":1000},"evidence":{"type":"array","minItems":1,"maxItems":1000,"items":{"$ref":"#/$defs/id"}},"confidence":{"type":"number","minimum":0,"maximum":1}}},"source":{"type":"object","additionalProperties":false,"required":["id","url","title","retrieved_at","kind"],"properties":{"id":{"$ref":"#/$defs/id"},"url":{"type":"string","format":"uri","maxLength":2048},"title":{"type":"string","minLength":1,"maxLength":500},"retrieved_at":{"$ref":"#/$defs/datetime"},"kind":{"type":"string","enum":["web","paper","video","dataset","other"]}}}}}